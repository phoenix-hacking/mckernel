include_directories(
	"${PROJECT_SOURCE_DIR}/linux/include"
	"${PROJECT_SOURCE_DIR}/linux/include/ihk/arch/${ARCH}"
	"${PROJECT_BINARY_DIR}/linux/include"
	"${PROJECT_BINARY_DIR}"
)

execute_process(COMMAND awk -F= "$1 == \"CONFIG_ARM64_64K_PAGES\" { print $2; exit; }" "${KERNEL_DIR}/.config"
	OUTPUT_VARIABLE CONFIG_ARM64_64K_PAGES OUTPUT_STRIP_TRAILING_WHITESPACE)
if(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
	if(CONFIG_ARM64_64K_PAGES STREQUAL "y")
		set(PAGE_SIZE "65536")
	else()
		set(PAGE_SIZE "4096")
	endif()
else()
		set(PAGE_SIZE "4096")
endif()
message("PAGE_SIZE: ${PAGE_SIZE}")

# Functional McKernel OS/apps and Rust/assembly migration only; no security testing.
# Root-owned private selection proposal. All70 API/6 DATA roots use the actual
# selected-SDK HOST-std library, never the old eleven-API partial-C composition.
# Keep compute RUSTC independent from the user-tool compiler below.
set(IHK_USER_RUSTC "" CACHE FILEPATH "Pinned user Rust compiler; independent of compute RUSTC")
option(IHK_ENABLE_RUST_WHOLE_LIBRARY "Select qualified supported-profile Rust libihk" ON)
option(IHK_ALLOW_CLI_C_FALLBACK "Select retained C CLI/library reference explicitly" OFF)
option(IHKLIB_USE_QUALIFIED_EXTERNAL_ARCHIVE "Use an explicitly qualified external Rust archive" OFF)
set(IHKLIB_QUALIFIED_RUST_ARCHIVE "" CACHE FILEPATH "Explicit qualified external SDK70 archive")
set(IHKLIB_ACTUAL_RUST_NATIVE_LIBS "" CACHE STRING "Same-compile native-static-libs in order")
if(IHK_ENABLE_RUST_WHOLE_LIBRARY)
  if(WITH_KRM OR ENABLE_KRM_WORKAROUND OR ENABLE_FUGAKU_HACKS
     OR ENABLE_FUGAKU_DEBUG OR NOT "${ARCH}" STREQUAL "x86_64"
     OR NOT "${PAGE_SIZE}" STREQUAL "4096" OR NOT ENABLE_MEMDUMP)
    message(FATAL_ERROR "Qualify the selected whole-library feature profile before changing it")
  endif()
  if(IHKLIB_USE_QUALIFIED_EXTERNAL_ARCHIVE)
    if(NOT IS_ABSOLUTE "${IHKLIB_QUALIFIED_RUST_ARCHIVE}"
       OR NOT EXISTS "${IHKLIB_QUALIFIED_RUST_ARCHIVE}"
       OR NOT IHKLIB_ACTUAL_RUST_NATIVE_LIBS)
      message(FATAL_ERROR "Bind qualified external archive and its same-compile native libraries")
    endif()
    set(_ihklib_archive "${IHKLIB_QUALIFIED_RUST_ARCHIVE}")
    set(_ihklib_native_libraries ${IHKLIB_ACTUAL_RUST_NATIVE_LIBS})
  else()
    include("${CMAKE_CURRENT_SOURCE_DIR}/rust/whole70/Whole70ProducerQualified.cmake")
    set(_ihklib_archive "${IHKLIB_PRODUCED_RUST_ARCHIVE}")
    # Linker response is generated by the SAME Rust invocation, in reported order.
    set(_ihklib_native_libraries "-Wl,@${IHKLIB_PRODUCED_NATIVE_RSP}")
  endif()
  set_source_files_properties("${_ihklib_archive}"
    PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
  add_library(ihklib SHARED "${_ihklib_archive}")
  if(NOT IHKLIB_USE_QUALIFIED_EXTERNAL_ARCHIVE)
    add_dependencies(ihklib ihklib_whole70_archive)
    set_property(TARGET ihklib APPEND PROPERTY LINK_DEPENDS "${IHKLIB_PRODUCED_NATIVE_RSP}")
  endif()
  set_target_properties(ihklib PROPERTIES LINKER_LANGUAGE C)
  set_property(TARGET ihklib APPEND_STRING PROPERTY LINK_FLAGS
    " -Wl,--gc-sections -Wl,-z,defs")
  set(IHKLIB_REQUIRED_ROOTS
    __argc
    __argv
    _ihk_os_assign_cpu_str
    _ihk_os_set_ikc_map_str
    _ihk_reserve_cpu_str
    _ihk_reserve_mem_str
    cpu_req2str
    cpu_str2count
    cpu_str2req
    dump_reserve_mem_conf
    ihk_create_os
    ihk_create_os_str
    ihk_destroy_os
    ihk_get_num_os_instances
    ihk_get_num_reserved_cpus
    ihk_get_num_reserved_mem_chunks
    ihk_get_os_instances
    ihk_os_assign_cpu
    ihk_os_assign_cpu_str
    ihk_os_assign_mem
    ihk_os_boot
    ihk_os_clear_kmsg
    ihk_os_freeze
    ihk_os_get_eventfd
    ihk_os_get_ikc_map
    ihk_os_get_kmsg_size
    ihk_os_get_num_assigned_cpus
    ihk_os_get_num_assigned_mem_chunks
    ihk_os_get_num_numa_nodes
    ihk_os_get_num_pagesizes
    ihk_os_get_pagesizes
    ihk_os_get_status
    ihk_os_getperfevent
    ihk_os_getrusage
    ihk_os_kargs
    ihk_os_kargs_str
    ihk_os_kmsg
    ihk_os_load
    ihk_os_makedumpfile
    ihk_os_perfctl
    ihk_os_query_cpu
    ihk_os_query_free_mem
    ihk_os_query_mem
    ihk_os_query_total_mem
    ihk_os_release_cpu
    ihk_os_release_mem
    ihk_os_set_ikc_map
    ihk_os_set_ikc_map_str
    ihk_os_setperfevent
    ihk_os_shutdown
    ihk_os_thaw
    ihk_query_cpu
    ihk_query_mem
    ihk_release_cpu
    ihk_release_mem
    ihk_reserve_cpu
    ihk_reserve_cpu_str
    ihk_reserve_mem
    ihk_reserve_mem_conf
    ihk_reserve_mem_conf_str
    ihk_reserve_mem_str
    ihk_set_loglevel
    ihklib_device_open
    ihklib_os_open
    ihklib_os_query_mem_sysfs
    ihklib_os_query_mem_type_str
    ikc_req2str
    ikc_str2count
    ikc_str2req
    loglevel
    mem_req2str
    mem_str2count
    mem_str2req
    namespace_files
    parse_env
    reserve_mem_conf)
  foreach(IHKLIB_REQUIRED_ROOT ${IHKLIB_REQUIRED_ROOTS})
    set_property(TARGET ihklib APPEND_STRING PROPERTY LINK_FLAGS
      " -Wl,--undefined=${IHKLIB_REQUIRED_ROOT}")
  endforeach()
  target_link_libraries(ihklib ${LIBBFD} ${_ihklib_native_libraries})
elseif(IHK_ALLOW_CLI_C_FALLBACK)
  # Explicit retained reference profile; no Rust-retirement/default credit.
  add_library(ihklib SHARED ihklib.c)
  target_link_libraries(ihklib ${LIBBFD})
else()
  message(FATAL_ERROR "C libihk reference selection must be explicit")
endif()
target_compile_definitions(ihklib PRIVATE -DPAGE_SIZE=${PAGE_SIZE})
SET_TARGET_PROPERTIES(ihklib PROPERTIES OUTPUT_NAME ihk)

# Functional McKernel OS/apps and Rust/assembly migration only; no security testing.
# Source-only successor: enable only after the selected target cohort qualifies.
# The ihklib provider closure remains separate debt; this is not M15 closure.
option(ENABLE_RUST_USER_TOOLS "Enable Rust helpers in McKernel user tools" ON)
option(IHK_ALLOW_CLI_C_FALLBACK "Select retained C CLI reference explicitly" OFF)
if(ENABLE_RUST_USER_TOOLS AND "${ARCH}" STREQUAL "x86_64")
  if(NOT IHK_USER_RUSTC OR NOT IS_ABSOLUTE "${IHK_USER_RUSTC}")
    message(FATAL_ERROR "Set absolute IHK_USER_RUSTC from the pinned user toolchain; preserve compute RUSTC")
  endif()
  find_package(PythonInterp 3 REQUIRED)
elseif(NOT IHK_ALLOW_CLI_C_FALLBACK)
  message(FATAL_ERROR "Supported CLI cohort requires Rust/x86_64; C reference selection must be explicit")
endif()

if(ENABLE_RUST_USER_TOOLS AND "${ARCH}" STREQUAL "x86_64")
  set(IHKCONFIG_RUST_OBJ "${CMAKE_CURRENT_BINARY_DIR}/rust/ihkconfig.o")
  add_custom_command(OUTPUT "${IHKCONFIG_RUST_OBJ}"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/rust"
    COMMAND ${PYTHON_EXECUTABLE} "${CMAKE_CURRENT_SOURCE_DIR}/rust/build_ihkconfig.py"
      --rustc "${IHK_USER_RUSTC}"
      --source "${CMAKE_CURRENT_SOURCE_DIR}/rust/ihkconfig.rs"
      --output "${IHKCONFIG_RUST_OBJ}"
      --config "${PROJECT_BINARY_DIR}/config.h"
      --krm "$<BOOL:${ENABLE_KRM_WORKAROUND}>"
    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/rust/ihkconfig.rs"
      "${CMAKE_CURRENT_SOURCE_DIR}/rust/build_ihkconfig.py"
      "${PROJECT_BINARY_DIR}/config.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihklib.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihklib_private.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihk_host_user.h"
    VERBATIM)
  add_custom_target(ihkconfig_rust_main DEPENDS "${IHKCONFIG_RUST_OBJ}")
  set_source_files_properties("${IHKCONFIG_RUST_OBJ}"
    PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
  add_executable(ihkconfig "${IHKCONFIG_RUST_OBJ}")
  add_dependencies(ihkconfig ihkconfig_rust_main)
  set_target_properties(ihkconfig PROPERTIES LINKER_LANGUAGE C)
else()
  # Only the explicitly requested comparison profile reaches this branch.
  add_executable(ihkconfig ihkconfig.c)
endif()
set_property(TARGET ihkconfig PROPERTY POSITION_INDEPENDENT_CODE ON)
set_property(TARGET ihkconfig PROPERTY LINK_FLAGS "-fPIE -pie")
target_link_libraries(ihkconfig ihklib ${LIBBFD})

if(ENABLE_RUST_USER_TOOLS AND "${ARCH}" STREQUAL "x86_64")
  set(IHKOSCTL_RUST_OBJ "${CMAKE_CURRENT_BINARY_DIR}/rust/ihkosctl.o")
  add_custom_command(OUTPUT "${IHKOSCTL_RUST_OBJ}"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/rust"
    COMMAND ${PYTHON_EXECUTABLE} "${CMAKE_CURRENT_SOURCE_DIR}/rust/build_ihkosctl.py"
      --rustc "${IHK_USER_RUSTC}"
      --source "${CMAKE_CURRENT_SOURCE_DIR}/rust/ihkosctl.rs"
      --output "${IHKOSCTL_RUST_OBJ}"
      --config "${PROJECT_BINARY_DIR}/config.h"
    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/rust/ihkosctl.rs"
      "${CMAKE_CURRENT_SOURCE_DIR}/rust/build_ihkosctl.py"
      "${PROJECT_BINARY_DIR}/config.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihklib.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihklib_private.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihk_host_user.h"
    VERBATIM)
  add_custom_target(ihkosctl_rust_main DEPENDS "${IHKOSCTL_RUST_OBJ}")
  set_source_files_properties("${IHKOSCTL_RUST_OBJ}"
    PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
  add_executable(ihkosctl "${IHKOSCTL_RUST_OBJ}")
  add_dependencies(ihkosctl ihkosctl_rust_main)
  set_target_properties(ihkosctl PROPERTIES LINKER_LANGUAGE C)
else()
  # Only the explicitly requested comparison profile reaches this branch.
  add_executable(ihkosctl ihkosctl.c)
endif()
set_property(TARGET ihkosctl PROPERTY POSITION_INDEPENDENT_CODE ON)
set_property(TARGET ihkosctl PROPERTY LINK_FLAGS "-fPIE -pie")
target_link_libraries(ihkosctl ihklib ${LIBBFD} ${LIBIBERTY})

# PRIVATE proposal: root coordinates this shared ihk/linux/user/CMakeLists.txt.
# Functional McKernel OS/apps and Rust/assembly migration only; no security testing.
# After qualification, put ihkmond.rs under ihk/linux/user/rust.
# Replace add_executable(ihkmond ihkmond.c), its PIC/link flag lines and
# target_link_libraries(ihkmond...) with this Rust binary build.
# Remove only "ihkmond" from the existing install(TARGETS ...) list, leaving
# ihkconfig/ihkosctl/ihklib. Install the same daemon name in SBINDIR below.
option(ENABLE_RUST_USER_TOOLS "Enable Rust helpers in McKernel user tools" ON)
if(ENABLE_RUST_USER_TOOLS AND ARCH STREQUAL "x86_64")
  if(NOT IHK_USER_RUSTC OR NOT IS_ABSOLUTE "${IHK_USER_RUSTC}"
     OR NOT EXISTS "${IHK_USER_RUSTC}" OR NOT LIBUDEV
     OR NOT IS_ABSOLUTE "${CMAKE_C_COMPILER}")
    message(FATAL_ERROR "Rust ihkmond requires rustc and the selected platform libudev")
  endif()
  set(IHKMOND_RUST_CFG "")
  if(ENABLE_KMSG_REDIRECT)
    list(APPEND IHKMOND_RUST_CFG --cfg ihkmond_kmsg_redirect)
  endif()
  set(IHKMOND_RUST_BIN "${CMAKE_CURRENT_BINARY_DIR}/ihkmond")
  add_custom_command(
    OUTPUT "${IHKMOND_RUST_BIN}"
    COMMAND ${CMAKE_COMMAND} -E env "IHKMOND_TMP=/tmp/ihkmond"
      "${IHK_USER_RUSTC}" --edition=2021 -C opt-level=2 -C debuginfo=1 -C relocation-model=pic
      ${IHKMOND_RUST_CFG}
      -C "linker=${CMAKE_C_COMPILER}"
      "${CMAKE_CURRENT_SOURCE_DIR}/rust/ihkmond.rs"
      -C "link-arg=$<TARGET_FILE:ihklib>"
      -C "link-arg=${LIBUDEV}"
      -C "link-arg=-Wl,-rpath,${CMAKE_INSTALL_FULL_LIBDIR}"
      -o "${IHKMOND_RUST_BIN}"
    DEPENDS ihklib "$<TARGET_FILE:ihklib>" "${LIBUDEV}"
      "${IHK_USER_RUSTC}" "${CMAKE_C_COMPILER}"
      "${CMAKE_CURRENT_SOURCE_DIR}/rust/ihkmond.rs"
      "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt"
      "${CMAKE_BINARY_DIR}/CMakeCache.txt"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihklib.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihklib_private.h"
      "${PROJECT_SOURCE_DIR}/linux/include/ihk/ihk_host_user.h"
    VERBATIM)
  add_custom_target(ihkmond ALL DEPENDS "${IHKMOND_RUST_BIN}")
  add_dependencies(ihkmond ihklib)
  install(PROGRAMS "${IHKMOND_RUST_BIN}" DESTINATION "${CMAKE_INSTALL_SBINDIR}")
elseif(IHK_ALLOW_CLI_C_FALLBACK)
  add_executable(ihkmond ihkmond.c)
  set_property(TARGET ihkmond PROPERTY POSITION_INDEPENDENT_CODE ON)
  set_property(TARGET ihkmond PROPERTY LINK_FLAGS "-fPIE -pie")
  target_link_libraries(ihkmond ihklib ${LIBUDEV} pthread)
  install(TARGETS ihkmond RUNTIME DESTINATION "${CMAKE_INSTALL_SBINDIR}")
else()
  message(FATAL_ERROR "Supported ihkmond successor requires Rust/x86_64; no silent production C fallback")
endif()
# No ihkmond_fixture cfg or test helper/stub is selected in production.
# Keep original C inactive as comparison source only after matching native proof.

configure_file(ihkconfig.1in ihkconfig.1 @ONLY)
configure_file(ihkosctl.1in ihkosctl.1 @ONLY)

option(ENABLE_GCOV "Enable GCOV" OFF)
if (ENABLE_GCOV)
	add_compile_options("-fprofile-arcs" "-ftest-coverage")
	add_link_options("-lgcov" "--coverage")
endif(ENABLE_GCOV)

# Functional McKernel OS/apps and Rust/assembly migration only; no security testing.
# Preserve the full install; permit a library-only DESTDIR suffix using the exact
# already-built default Rust provider without rebuilding its compiler prefix.
install(TARGETS "ihklib"
	LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT ihklib_runtime
	ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT ihklib_development)
# Functional McKernel OS/apps and Rust/assembly migration only; no security testing.
# Select the already-built management CLI alone without unrelated user targets.
# An unqualified install still includes both runtime components.
install(TARGETS "ihkconfig"
	RUNTIME DESTINATION "${CMAKE_INSTALL_SBINDIR}" COMPONENT ihkconfig_runtime
	LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
	ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
install(TARGETS "ihkosctl"
	RUNTIME DESTINATION "${CMAKE_INSTALL_SBINDIR}"
	LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
	ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
install(FILES
		"${CMAKE_CURRENT_BINARY_DIR}/ihkconfig.1"
		"${CMAKE_CURRENT_BINARY_DIR}/ihkosctl.1"
	DESTINATION "${CMAKE_INSTALL_MANDIR}/man1")
install(FILES "../include/ihk/ihklib.h"
	DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
install(FILES "../include/ihk/affinity.h"
	DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/ihk")


