+#[cfg(all(enable_perf, f03_perf_counter_control_bridges_selected_candidate))]
+#[no_mangle]
+pub unsafe extern "C" fn perf_counter_stop_bridge(counter_mask: CULong, flags: CInt) -> CInt {
