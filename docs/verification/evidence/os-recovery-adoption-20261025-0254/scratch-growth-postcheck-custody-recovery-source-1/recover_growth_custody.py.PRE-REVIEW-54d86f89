def canonical(v):return (json.dumps(v,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode()
def reference(p):
    raw=Path(p).read_bytes();return dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def bound(r,document=True,root=True):
    need(isinstance(r,dict) and set(r)=={'path','bytes','sha256'},'exact evidence reference')
    p=Path(r['path']);s=p.lstat();need(p.is_absolute() and not p.is_symlink() and (s.st_uid==0 if root else s.st_uid in (0,1000)) and s.st_nlink==1,'owned evidence')
    raw=p.read_bytes();need(len(raw)==r['bytes'] and hashlib.sha256(raw).hexdigest()==r['sha256'],'changed evidence')
    return json.loads(raw) if document else raw

