_Static_assert(8 == 8 && sizeof(long) == 8 && sizeof(void *) == 8, "LP64 ABI");
typedef long (*upper_type)(bfd *);
typedef long (*canonicalize_type)(bfd *, asymbol **);
_Static_assert(_Generic(((bfd_target *)0)->_bfd_get_symtab_upper_bound,
                       upper_type: 1, default: 0), "upper callback ABI");
_Static_assert(_Generic(((bfd_target *)0)->_bfd_canonicalize_symtab,
                       canonicalize_type: 1, default: 0), "canonicalize callback ABI");
_Static_assert(sizeof(upper_type) == 8 && sizeof(canonicalize_type) == 8, "function pointer ABI");
_Static_assert(_Alignof(upper_type) == 8 && _Alignof(canonicalize_type) == 8, "callback alignment");
_Static_assert(__builtin_offsetof (bfd, xvec) % 8 == 0, "xvec alignment");
_Static_assert(__builtin_offsetof (bfd_target, _bfd_get_symtab_upper_bound) % 8 == 0, "upper alignment");
_Static_assert(__builtin_offsetof (bfd_target, _bfd_canonicalize_symtab) % 8 == 0, "canonicalize alignment");
long witness_upper(bfd *b) { return ((*((b)->xvec->_bfd_get_symtab_upper_bound)) (b)); }
long witness_canonicalize(bfd *b, asymbol **s) { return ((*((b)->xvec->_bfd_canonicalize_symtab)) (b, s)); }
int main(void) {
    printf("// Generated from selected pinned BFD header; not a portable BFD layout.\n");
    printf("pub const BFD_XVEC_OFFSET: usize = %zu;\n", __builtin_offsetof (bfd, xvec));
    printf("pub const BFD_UPPER_OFFSET: usize = %zu;\n", __builtin_offsetof (bfd_target, _bfd_get_symtab_upper_bound));
    printf("pub const BFD_CANONICALIZE_OFFSET: usize = %zu;\n", __builtin_offsetof (bfd_target, _bfd_canonicalize_symtab));
    printf("// sizeof(bfd)=%zu align=%zu; sizeof(bfd_target)=%zu align=%zu\n",
           sizeof(bfd), _Alignof(bfd), sizeof(bfd_target), _Alignof(bfd_target));
    return 0;
}
