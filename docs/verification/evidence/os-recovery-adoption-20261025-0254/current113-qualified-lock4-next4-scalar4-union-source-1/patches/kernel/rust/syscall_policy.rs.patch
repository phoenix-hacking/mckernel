+    #[no_mangle]
+    pub unsafe extern "C" fn ptrace_wakeup_update_unlock_bridge(
+        lock_addr: CULong,
+        node: *mut c_void,
+    ) {
+        // SAFETY: Use the same lock and node, retaining the provider's flag restore.
+        unsafe {
+            crate::lock_helpers::__mcs_rwlock_writer_unlock(
+                lock_addr as *mut McsRwlockLock,
+                node.cast::<McsRwlockNodeIrqsave>(),
+            );
+        }
+    }
+
+    const _: PtraceRwlockFn = ptrace_wakeup_update_lock_bridge;
+    const _: PtraceRwlockFn = ptrace_wakeup_update_unlock_bridge;
