+// Functional McKernel OS/apps and Rust/assembly migration only; no security testing.
+// Private candidate: PID epoch and reserved diagnostic slots share one atomic word.
+use core::sync::atomic::{AtomicU64, Ordering};
+
+const F06_LOG_LIMIT: u32 = 64;
+pub(super) static F06_SIGNAL_LOG_STATE: AtomicU64 = AtomicU64::new((u32::MAX as u64) << 32);
+
+// Called once at the original do_signal entry reset point, even for signals that
+// do not ultimately log. The high word contains the bit representation of pid.
+pub(super) fn f06_log_observe_pid(state: &AtomicU64, pid: i32) {
+    let pid_bits = (pid as u32 as u64) << 32;
+    let mut seen = state.load(Ordering::Relaxed);
+    loop {
+        if seen & 0xffff_ffff_0000_0000 == pid_bits { return; }
+        match state.compare_exchange_weak(seen, pid_bits, Ordering::Relaxed, Ordering::Relaxed) {
+            Ok(_) => return,
+            Err(next) => seen = next,
+        }
+    }
+}
+
+// Claim against the CURRENT epoch at the original log site. A different PID can
+// have entered since this invocation began; do not reset to this caller's PID.
+// Claim precedes kprintf so simultaneous or reentrant calls cannot exceed 64.
+pub(super) fn f06_log_claim(state: &AtomicU64) -> bool {
+    let mut seen = state.load(Ordering::Relaxed);
+    loop {
+        let count = seen as u32;
+        if count >= F06_LOG_LIMIT { return false; }
+        match state.compare_exchange_weak(seen, seen + 1, Ordering::Relaxed, Ordering::Relaxed) {
+            Ok(_) => return true,
+            Err(next) => seen = next,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, Barrier};
+    use std::thread;
+
+    #[test]
+    fn limit_reset_and_delayed_invocation_use_current_epoch() {
+        let state = AtomicU64::new((u32::MAX as u64) << 32);
+        f06_log_observe_pid(&state, 17);
+        assert!((0..64).all(|_| f06_log_claim(&state)));
+        assert!(!f06_log_claim(&state));
+        f06_log_observe_pid(&state, 17);
+        assert!(!f06_log_claim(&state));
+        f06_log_observe_pid(&state, 18); // entry without a log resets too
+        assert!(f06_log_claim(&state)); // delayed PID 17 claims current epoch
+        assert_eq!(state.load(Ordering::Relaxed), (18u64 << 32) | 1);
+        f06_log_observe_pid(&state, -1);
+        assert!(f06_log_claim(&state));
+        assert_eq!(state.load(Ordering::Relaxed), ((u32::MAX as u64) << 32) | 1);
+    }
+
+    #[test]
+    fn simultaneous_claims_never_exceed_limit() {
+        let state = Arc::new(AtomicU64::new(0));
+        f06_log_observe_pid(&state, 91);
+        let barrier = Arc::new(Barrier::new(16));
+        let handles: Vec<_> = (0..16).map(|_| {
+            let state = Arc::clone(&state);
+            let barrier = Arc::clone(&barrier);
+            thread::spawn(move || {
+                barrier.wait();
+                (0..32).filter(|_| f06_log_claim(&state)).count()
+            })
+        }).collect();
+        assert_eq!(handles.into_iter().map(|h| h.join().unwrap()).sum::<usize>(), 64);
+        assert_eq!(state.load(Ordering::Relaxed), (91u64 << 32) | 64);
+    }
+
+    #[test]
+    fn serial_schedule_matches_original_counter() {
+        // Original reset happens on every entry, including nonlogging signals.
+        // In the non-reentrant serial domain original increment follows logging.
+        let state = AtomicU64::new((u32::MAX as u64) << 32);
+        let (mut old_pid, mut old_count) = (-1i32, 0u32);
+        let events = [(-1, false), (1, false), (1, true), (2, false),
+                      (1, true), (1, true), (-1, true)];
+        let mut sequence = events.to_vec();
+        sequence.extend((0..70).map(|_| (-1, true)));
+        sequence.extend([(4, false), (4, true), (1, true)]);
+        for (pid, logs) in sequence {
+            if pid != old_pid { old_pid = pid; old_count = 0; }
+            f06_log_observe_pid(&state, pid);
+            if logs {
+                let original_logs = old_count < 64;
+                if original_logs { old_count += 1; }
+                assert_eq!(f06_log_claim(&state), original_logs);
+            }
+            assert_eq!(state.load(Ordering::Relaxed),
+                       ((old_pid as u32 as u64) << 32) | u64::from(old_count));
+        }
+    }
+
+    #[test]
+    fn logger_reentry_cannot_overbook_last_slot() {
+        let state = AtomicU64::new(0);
+        f06_log_observe_pid(&state, 7);
+        assert!((0..63).all(|_| f06_log_claim(&state)));
+        // Outer logger reserves slot 64 before a reentrant logger is called.
+        assert!(f06_log_claim(&state));
+        assert!(!f06_log_claim(&state));
+        assert_eq!(state.load(Ordering::Relaxed), (7u64 << 32) | 64);
+    }
+
+    #[test]
+    fn concurrent_pid_switches_keep_a_valid_bounded_epoch() {
+        let state = Arc::new(AtomicU64::new(0));
+        let barrier = Arc::new(Barrier::new(8));
+        let handles: Vec<_> = (0..8).map(|i| {
+            let state = Arc::clone(&state);
+            let barrier = Arc::clone(&barrier);
+            thread::spawn(move || {
+                barrier.wait();
+                for n in 0..500 {
+                    let pid = 1 + ((i + n) & 1);
+                    f06_log_observe_pid(&state, pid);
+                    let _ = f06_log_claim(&state);
+                    let observed = state.load(Ordering::Relaxed);
+                    assert!((1..=2).contains(&(observed >> 32)));
+                    assert!((observed as u32) <= 64);
+                }
+            })
+        }).collect();
+        for handle in handles { handle.join().unwrap(); }
+        f06_log_observe_pid(&state, 42);
+        assert_eq!(state.load(Ordering::Relaxed), 42u64 << 32);
+        assert!(f06_log_claim(&state));
+    }
+}
