+// This entry binds the current x86 counter provider, which only scans the
+// thread's allocation map. At this point the event is freshly allocated and
+// unpublished: group linkage, host FD and map update have not yet occurred.
+// A failed scan therefore leaves the entry owning exactly this allocation.
+// The selected matching free bridge consumes it; preserve the original errno.
+unsafe extern "C" fn perf_entry_counter_alloc_or_release(
+    thread: *mut c_void, event: *mut c_void,
+) -> CInt {
+    let result = unsafe { f03_perf_counter_allocate_v1(thread, event) };
+    if result < 0 {
+        unsafe { perf_event_alloc_free_bridge(event) };
+    }
+    result
+}
