+def _sdk13_client_deadlines(boundary,timeout,now):
+    origin=boundary.get('mono')
+    if not isinstance(origin,(int,float)) or not isinstance(timeout,(int,float)) or timeout<=0:
+        raise RuntimeError('SDK13 client deadline input invalid')
+    deadline=boundary.get('absolute_deadline_mono',origin+timeout)
+    if not isinstance(deadline,(int,float)) or not origin<deadline<=origin+timeout:
+        raise RuntimeError('SDK13 absolute client deadline invalid')
+    work_deadline=deadline-5.0
+    if now>=work_deadline:raise TimeoutError('SDK13 no client retirement window')
+    return deadline,work_deadline
+
+def _sdk13_deadline_remaining(deadline,now,max_wait):
+    remaining=deadline-now
+    if remaining<=0:raise TimeoutError('SDK13 client retirement deadline')
+    return min(max_wait,remaining)
