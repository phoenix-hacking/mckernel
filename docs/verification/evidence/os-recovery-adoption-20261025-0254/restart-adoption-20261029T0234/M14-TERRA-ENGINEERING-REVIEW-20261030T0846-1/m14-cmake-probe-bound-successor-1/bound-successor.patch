         --phase identity --kernel-dir "${KERNEL_DIR}" --uname-r "${MCKERNEL_M14_EXPECTED_UNAME_R}"
         --expected-map "${MCKERNEL_M14_EXPECTED_MAP_KERNEL_START}"
