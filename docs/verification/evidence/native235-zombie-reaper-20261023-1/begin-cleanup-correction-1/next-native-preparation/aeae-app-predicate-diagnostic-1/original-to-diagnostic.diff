+// Functional diagnostic only; failure exits bypass stdio after parent cleanup.
+fn diagnostic_exit_code(stage: &str) -> i32 {
+    match stage {
+        "waitpid ECHILD" => 110,
+        "waitpid other error" => 111,
+        "child status untouched" => 112,
+        "child status abnormal" => 113,
+        "success child exit code" => 114,
+        "missing child exit code" => 115,
+        "success child bytes" => 116,
+        "missing child bytes" => 117,
+        "parent close reader" => 118,
+        "second wait zero" => 119,
+        "second wait nonzero" => 120,
+        "second wait errno" => 121,
+        "second wait deadline" => 122,
+        "pipe2" => 123,
+        "fork" => 124,
+        "parent close writer" => 125,
+        "capture deadline" => 126,
+        "child output overflow" => 127,
+        "read child" => 128,
+        "poll child" => 129,
+        "forward child marker" => 130,
+        "parent arguments" => 131,
+        "absolute executable path" => 132,
+        "executable NUL" => 133,
+        "SIGCHLD policy" => 134,
+        "clock" => 135,
+        "parent start" => 136,
+        "success output" => 137,
+        "error output" => 138,
+        "create observations" => 139,
+        "write observations" => 140,
+        _ => 141,
+    }
+}
