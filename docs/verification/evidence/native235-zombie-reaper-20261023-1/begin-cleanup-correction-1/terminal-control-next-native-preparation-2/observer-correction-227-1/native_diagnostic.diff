+def _begin_cancel_case(manifest):
+    """Only the original SIGTERM227 payload/oracle has cancellation authority.
+
+    Its frozen source waits READY, checks waitpid(child,WNOHANG)==0, signals
+    that SAME owned child with SIGTERM15, requires raw signal15/EOF/reap/ECHILD,
+    then creates a distinct recovery child. stdout is checked before this hook.
+    No host nr62 row is claimed: the guest implements that signal locally.
+    """
+    if manifest["case_id"] != BEGIN_PROCESS_CASES[1]:return False
+    _need(_begin_cleanup_enabled(manifest) and
+          manifest["artifacts"]["payload"]["sha256"] == "6abb5e9046444c64d72139f85fcae9e4796eff7ceb5cc2dd1e5b1a47ef3695a5" and
+          manifest["payload"]["oracle"] == CANCEL_227_ORACLE, "frozen227 cancellation payload/oracle")
+    return True
+
+CANCEL_227_ORACLE = {'exit_code': 0, 'stderr_hex': '', 'stdout_hex': ''}
