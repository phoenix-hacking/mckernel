  "source_return_paths": [
    {
      "source": "long_bridge.inc:81-94",
      "fact": "Actual launch returns before load on !safe or nonzero code. pair_fail_phase is not reset here; last strict gate phase remains from round47."
    },
    {
      "source": "pair_collector.inc:60-105",
      "fact": "pair_run_assigned keeps safe0 on uncertain owner wait; exited worker2 sets safe0. This launch failure is consistent with retained failed service/worker rows, not a trace-retention rejection."
    },
    {
      "source": "smp_service.rs:162-166",
      "fact": "Runtime.fail logs only errno after application.fail_service; it omits origin, packet type and claim state."
    },
    {
      "source": "smp_service.rs:494-509",
      "fact": "pump_regular retains pending only for EAGAIN. Any other dispatch error clears that pending slot and calls fail; no general EBUSY retry is authorized."
    },
    {
      "source": "smp_service.rs:576-595,720-728",
      "fact": "pump stages and metadata/zeroing worker results use the same generic fail. Retained errno-16 alone does not distinguish these origins."
    },
    {
      "source": "smp_application.rs:958-970",
      "fact": "fail_service records first service error, invokes quarantine_transport on retained slots, then wakes waiters; WAIT-32/reap-retained-71/cleanup-intent-71 follow this retained ownership policy."
    },
    {
      "source": "sysfs_memory.rs:348-379 -> smp_application_syscall.rs:174-208 -> smp_application.rs:770-782",
      "fact": "One reachable exact EBUSY predicate is ledger.conflicts(response_span,true) during Memory.syscall. Response-slot capacity exhaustion is EAGAIN, not EBUSY. Remote.syscall_request quarantines non-EAGAIN admission errors. This is a candidate path, not proved actual cause, because response physical/ledger ownership is absent."
    },
    {
      "source": "smp_service.rs:289-305; smp_application.rs:974-999",
      "fact": "Existing sysfs mapping duplicate EBUSY and prepublication queue EBUSY/EAGAIN have explicit local handling. Their presence shows error classification is boundary-specific; do not treat every EBUSY as retriable."
    }
  ],
  "concrete_semantic_fix": null,
  "reason_no_semantic_fix": "First fatal EBUSY and its ownership consequences are observed; the packet/origin/claim predicate is not retained. Changing admission, quarantine, retry policy or ownership before identifying that predicate would be unsupported.",
