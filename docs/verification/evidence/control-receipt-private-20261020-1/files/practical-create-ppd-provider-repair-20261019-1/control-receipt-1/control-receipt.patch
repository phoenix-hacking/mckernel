+            if let Some(control) = c.fork.as_mut().and_then(|f|f.control.as_mut()) {
+                if control.descriptor == self.descriptor && control.request == self.request {
+                    control.quarantined = true; c.quarantined = true;
+                }
+            }
+        }
+    }
