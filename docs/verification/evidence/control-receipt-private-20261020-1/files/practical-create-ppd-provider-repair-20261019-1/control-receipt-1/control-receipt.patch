+unsafe extern "C" fn resolve_fork_control_receipt_scope(
+    context: *mut c_void, descriptor: *const super::application_abi::ForkControlV1,
+    resume: Option<super::application_abi::ForkControlResumeV1>, ticket: *mut c_void,
