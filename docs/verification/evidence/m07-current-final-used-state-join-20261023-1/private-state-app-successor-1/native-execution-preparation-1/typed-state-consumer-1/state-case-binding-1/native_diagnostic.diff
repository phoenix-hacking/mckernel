+    _need(any(published[waiter] < i < deleted[waiter] for i in waits), "state actual sampled blocking futex")
+    return {"parent_tid": parent, "waiter_tid": waiter, "PAIR_CPU": 0,
+            "registered_tid_count": 2, "all_registered_tids_deleted": True}
