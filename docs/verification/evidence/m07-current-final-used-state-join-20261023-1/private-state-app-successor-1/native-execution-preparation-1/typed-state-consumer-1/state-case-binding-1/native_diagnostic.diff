+        if "application procfs " not in line:
+            continue
+        match = re.search(r"application procfs (published|deleted) " + re.escape(prefix) + r" tid=(\d+)\s*$", line)
+        _need(match is not None, "state foreign/malformed thread procfs row")
+        operation, tid = match[1], int(match[2])
+        _need(tid > 0 and tid not in events[operation], "state duplicate/invalid thread procfs row")
+        events[operation][tid] = position
+    published, deleted = events["published"], events["deleted"]
+    _need(set(published) == set(deleted) and len(published) == 2 and parent in published,
+          "state exact parent/waiter publication and deletion")
+    waiter = next(tid for tid in published if tid != parent)
+    _need(published[parent] < published[waiter] < deleted[waiter] < deleted[parent],
