+def _check_state_thread_trace(serial, prefix):
+    # App waits for exactly one bounded waiter and joins it before returning.
+    # Keep original parent delivery/RET/route checker; add exact procfs ledger.
+    owner = re.fullmatch(r"os=(\d+) generation=(\d+) pid=(\d+)", prefix)
