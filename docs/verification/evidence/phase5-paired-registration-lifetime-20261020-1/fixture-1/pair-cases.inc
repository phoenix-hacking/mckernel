#[cfg(test)] mod pair_tests {
 use super::*;
 fn proof(child:&Arc<Registration>)->ForkPreparedV3{ForkPreparedV3{geometry:ForkGeometryV3{root:4096,start:8192,length:12288},child_pid:child.pid,reserved:0,child_mm:400,response:500,nonce:600}}
 fn bytes(selector:u64,pid:u64,carrier:u64)->[u8;96]{let mut b=[0;96];for(at,v)in[(8,91u64),(48,selector),(56,pid),(64,12288),(72,4096),(80,carrier)]{b[at..at+8].copy_from_slice(&v.to_le_bytes())}b}
 fn pair()->(Arc<Registration>,Arc<Registration>){table().lock().clear();MODE.store(0,Ordering::SeqCst);let p=Registration::new(10,100);let c=Registration::new(20,200);c.reserve_fork_pair(&p,&proof(&c)).unwrap();(p,c)}
 #[test] fn pair_pending_identity_not_zero_key(){let(p,c)=pair();let d=Registration::new(21,201);d.reserve_fork_pair(&p,&proof(&d)).unwrap();assert!(p.select_fork_child(3,0,0,0,0).is_err());assert!(Arc::ptr_eq(&p.select_fork_child(2,800,20,12288,4096).unwrap(),&c));assert!(Arc::ptr_eq(&p.select_fork_child(2,808,21,12288,4096).unwrap(),&d));for(pid,len,root)in[(22,12288,4096),(20,1,4096),(20,12288,8192)]{assert!(p.select_fork_child(2,800,pid,len,root).is_err());}let reused=Registration::new(20,202);assert_eq!(reused.reserve_fork_pair(&p,&proof(&reused)),Err(EBUSY));assert!(reused.fork_parent.lock().is_none());}
 #[test] fn pair_capacity_and_bind_never_allocate(){let p=Registration::new(10,100);let mut owned=std::vec::Vec::new();for pid in 20..84{let c=Registration::new(pid,pid as u64+1000);c.reserve_fork_pair(&p,&proof(&c)).unwrap();owned.push(c);}assert_eq!(p.control_children.lock().len(),64);let c=Registration::new(84,1084);assert_eq!(c.reserve_fork_pair(&p,&proof(&c)),Err(EBUSY));assert!(c.fork_parent.lock().is_none());for(i,c)in owned.iter().enumerate(){p.bind_fork_carrier(c,800+i as u64*8).unwrap();}assert_eq!(p.control_children.lock().len(),64);assert_eq!(p.control_children.lock().0.capacity(),64);}
 #[test] fn pair_rollback_requires_exact_private_proof(){let(p,c)=pair();for which in 0..3{let mut bad=proof(&c);match which{0=>bad.response+=1,1=>bad.child_mm+=1,_=>bad.nonce+=1}assert_eq!(c.cancel_private_fork_pair(&p,&bad),Err(EACCES));assert!(c.fork_parent.lock().is_some());assert_eq!(p.control_children.lock().len(),1);}c.cancel_private_fork_pair(&p,&proof(&c)).unwrap();assert!(c.fork_parent.lock().is_none());assert!(p.control_children.lock().is_empty());c.reserve_fork_pair(&p,&proof(&c)).unwrap();p.bind_fork_carrier(&c,800).unwrap();assert_eq!(c.cancel_private_fork_pair(&p,&proof(&c)),Err(EACCES));assert!(c.fork_parent.lock().is_some());}
 #[test] fn pair_refusal_and_uncertain_publication_retain_both(){for mode in [0,1,3]{let(p,c)=pair();let wp=Arc::downgrade(&p);let wc=Arc::downgrade(&c);MODE.store(mode,Ordering::SeqCst);assert!(p.fork_control_current(&HostWorker{handle:1},&bytes(2,20,800)).is_err());assert_eq!(p.control_children.lock().len(),1);assert!(c.fork_parent.lock().is_some());drop(p);drop(c);assert!(wp.upgrade().is_some()&&wc.upgrade().is_some());}}
 #[test] fn pair_cross_worker_auth_ack_exact_once(){let(p,c)=pair();let d=Registration::new(21,201);d.reserve_fork_pair(&p,&proof(&d)).unwrap();MODE.store(2,Ordering::SeqCst);p.fork_control_current(&HostWorker{handle:1},&bytes(2,20,800)).unwrap();assert_eq!(p.control_children.lock().len(),2);p.fork_control_current(&HostWorker{handle:2},&bytes(3,0,800)).unwrap();assert_eq!(p.control_children.lock().len(),1);assert!(Arc::ptr_eq(&p.control_children.lock()[0].child,&d));assert!(!c.armed.load(Ordering::Acquire));assert!(p.fork_control_current(&HostWorker{handle:2},&bytes(3,0,800)).is_err());assert!(d.armed.load(Ordering::Acquire));}
 #[test] fn pair_reused_table_pid_is_not_owned_child(){let(p,c)=pair();let other=Registration::new(20,999);table().lock().push(Entry{process:Arc::new(Process{slot:1,generation:7,pid:other._pid.clone(),registration:Mutex::new(Some(other))})});assert_eq!(p.fork_control_current(&HostWorker{handle:1},&bytes(2,20,800)),Err(EACCES));assert_eq!(p.control_children.lock()[0].carrier,0);assert!(c.fork_parent.lock().is_some());table().lock().clear();}
 #[test] fn pair_final_child_drop_releases_parent_only_after_ack(){let(p,c)=pair();let wp=Arc::downgrade(&p);let wc=Arc::downgrade(&c);MODE.store(2,Ordering::SeqCst);p.fork_control_current(&HostWorker{handle:1},&bytes(2,20,800)).unwrap();let held=c.fork_parent.lock().as_ref().unwrap().clone();drop(p);held.fork_control_current(&HostWorker{handle:2},&bytes(3,0,800)).unwrap();drop(held);assert!(wp.upgrade().is_some());drop(c);assert!(wc.upgrade().is_none());assert!(wp.upgrade().is_none());}
 #[test] fn pair_concurrent_reservation_and_carrier_claim(){
  let p=Registration::new(10,100);let c=Registration::new(20,200);let barrier=Arc::new(std::sync::Barrier::new(3));
  let mut jobs=std::vec::Vec::new();for _ in 0..2{let(p,c,b)=(p.clone(),c.clone(),barrier.clone());jobs.push(std::thread::spawn(move||{b.wait();c.reserve_fork_pair(&p,&proof(&c))}));}barrier.wait();let results:std::vec::Vec<_>=jobs.into_iter().map(|j|j.join().unwrap()).collect();assert_eq!(results.iter().filter(|r|r.is_ok()).count(),1);assert_eq!(p.control_children.lock().len(),1);
  let d=Registration::new(21,201);d.reserve_fork_pair(&p,&proof(&d)).unwrap();let barrier=Arc::new(std::sync::Barrier::new(3));let mut jobs=std::vec::Vec::new();for child in [c,d]{let(p,b)=(p.clone(),barrier.clone());jobs.push(std::thread::spawn(move||{b.wait();p.bind_fork_carrier(&child,800)}));}barrier.wait();let results:std::vec::Vec<_>=jobs.into_iter().map(|j|j.join().unwrap()).collect();assert_eq!(results.iter().filter(|r|r.is_ok()).count(),1);assert_eq!(p.control_children.lock().iter().filter(|row|row.carrier==800).count(),1);assert_eq!(p.control_children.lock().iter().filter(|row|row.carrier==0).count(),1);
 }

}
