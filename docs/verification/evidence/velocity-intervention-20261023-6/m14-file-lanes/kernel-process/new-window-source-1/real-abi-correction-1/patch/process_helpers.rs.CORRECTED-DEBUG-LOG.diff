 const _: unsafe extern "C" fn(*mut ProcessVm, *mut VmRange, CULong, CULong) -> CInt =
     process_xpmem_fault_range_bridge;
 const _: unsafe extern "C" fn(*mut c_void, *mut c_void) = process_pgio_dispatch_bridge;
