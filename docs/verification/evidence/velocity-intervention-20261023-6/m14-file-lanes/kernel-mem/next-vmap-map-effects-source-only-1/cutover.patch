+
+/// Same public Rust page-table setter; attributes and error result unchanged.
+#[no_mangle]
+pub unsafe extern "C" fn mem_pt_set_page_bridge(
+    pt: *mut c_void,
+    virt: *mut c_void,
+    phys: CULong,
+    attr: IhkMcPtAttribute,
+) -> CInt {
+    unsafe { crate::x86_memory_helpers::ihk_mc_pt_set_page(pt, virt, phys, attr) }
+}
+
+/// Same public clearer, including existing default-root and walk/error behavior.
+#[no_mangle]
+pub unsafe extern "C" fn mem_pt_clear_page_bridge(pt: *mut c_void, virt: *mut c_void) -> CInt {
+    unsafe { crate::x86_memory_helpers::ihk_mc_pt_clear_page(pt, virt) }
+}
+
+/// Reuse the already production-tested Rust TLB callback to the same assembly
+/// endpoint. No address normalization, CPU selection or asynchronous completion.
+#[no_mangle]
+pub unsafe extern "C" fn mem_flush_tlb_single_bridge(addr: CULong) {
+    unsafe { mem_tlb_flush_single_bridge(addr) }
+}
+
+/// Reuse the existing empty-asm compiler memory barrier, matching C barrier().
+/// This does not add a hardware memory fence or change mapping publication.
+#[no_mangle]
+pub unsafe extern "C" fn mem_barrier_bridge() {
+    unsafe { crate::x86_cpu_helpers::arch_barrier() }
+}
