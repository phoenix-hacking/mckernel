+// C retains its existing private vmap_allocator object. These data symbols
+// expose only its immutable address and exact configured geometry; no C getter.
+unsafe extern "C" {
+    static mem_vmap_allocator_slot: *mut *mut c_void;
+    static mem_vmap_init_start: CULong;
+    static mem_vmap_init_size: CULong;
+    static mem_vmap_init_unit: CULong;
+    static mem_vmap_init_first_level: CInt;
+}
+
+/// Plain read of the same C-owned allocator pointer, including null.
+/// No reference/exclusive borrow or allocator lifetime change is introduced.
+#[no_mangle]
+pub unsafe extern "C" fn mem_vmap_allocator_bridge() -> *mut c_void {
+    unsafe { core::ptr::read(mem_vmap_allocator_slot) }
+}
+
+/// Same init -> store descriptor -> prepare first-level mappings sequence.
+/// The original C void wrapper ignored the helper's status; preserve that.
+#[no_mangle]
+pub unsafe extern "C" fn virtual_allocator_init() {
+    unsafe {
+        let _ = mem_virtual_allocator_init_body_result(
+            mem_vmap_allocator_slot,
+            mem_vmap_init_start,
+            mem_vmap_init_size,
+            mem_vmap_init_unit,
+            mem_vmap_init_first_level,
+            Some(mem_vmap_init_bridge),
+            Some(mem_pt_prepare_map_bridge),
+        );
+    }
+}
