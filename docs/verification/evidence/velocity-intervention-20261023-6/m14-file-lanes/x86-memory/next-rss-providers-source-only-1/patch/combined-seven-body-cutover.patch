+    memobj: *mut c_void,
+    size: CULong,
+    pgsize: CULong,
+) {
+    unsafe {
+        crate::mem_helpers::rusage_memory_stat_sub(memobj.cast::<Memobj>(), size, pgsize as CInt)
+    }
