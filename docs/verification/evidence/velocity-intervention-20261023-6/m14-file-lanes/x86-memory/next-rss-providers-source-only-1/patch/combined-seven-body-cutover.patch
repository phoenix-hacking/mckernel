+#[no_mangle]
+pub unsafe extern "C" fn x86_clear_rss_sub_bridge(size: CULong, pgsize: CULong) {
+    unsafe { crate::mem_helpers::memory_stat_rss_sub(size, pgsize as CInt) }
+}
