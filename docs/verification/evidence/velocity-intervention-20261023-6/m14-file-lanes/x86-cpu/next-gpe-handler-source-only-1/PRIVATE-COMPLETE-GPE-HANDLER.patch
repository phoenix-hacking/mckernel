+            core::ptr::addr_of!((*regs).gpr.error).read(),
+            core::ptr::addr_of!((*regs).gpr.cs).read(),
+            core::ptr::addr_of!((*regs).gpr.rip).read(),
+        );
+        x86_gpe_show_context(regs.cast::<c_void>());
