+        x86_gpe_set_cputime(if x86_gpe_from_user(regs.cast::<c_void>()) != 0 {
+            X86_GPE_CPUTIME_K2U
+        } else {
+            X86_GPE_CPUTIME_K2K_OUT
+        });
+        x86_gpe_panic(b"GPF\0".as_ptr().cast());
+    }
