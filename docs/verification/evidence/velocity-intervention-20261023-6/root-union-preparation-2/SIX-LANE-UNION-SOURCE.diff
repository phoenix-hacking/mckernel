+        len = len.wrapping_add(unsafe {
+            snprintf(
+                out.wrapping_add(len), BUF_LEN.wrapping_sub(len),
+                b" %#16lx\0".as_ptr().cast(), ip,
+            )
+        } as usize);
+        rbp = unsafe { rbp.read() } as *mut CULong;
+    }
+    unsafe { __kprintf(b"%s\n\0".as_ptr().cast(), out); }
