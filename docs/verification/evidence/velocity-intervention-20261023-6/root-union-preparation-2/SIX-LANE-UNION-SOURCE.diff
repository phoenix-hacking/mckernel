+    let (vdso, _, _) = match unsafe { arch_vdso_state() } {
+        Ok(state) => state,
+        Err(error) => return error,
+    };
+    unsafe {
+        vdso_map_global_pages_body_result(
+            vdso,
+            addr_of_mut!(ARCH_VDSO_GLOBAL_PVTI),
+            addr_of_mut!(ARCH_VDSO_GLOBAL_PVTI_NPAGES),
