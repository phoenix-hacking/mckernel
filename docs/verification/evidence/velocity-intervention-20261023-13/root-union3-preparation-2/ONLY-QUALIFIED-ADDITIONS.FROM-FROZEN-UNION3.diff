+    }
+    if sig == SIGKILL || sig == SIGSTOP {
+        return 0;
+    }
+    if num < 0 || rc != (-(EINTR as CLong)) as CULong {
+        return 0;
+    }
+    // Preserve this shortcut before the non-restarting syscall set.
+    if sig == SIGCHLD {
+        return 1;
+    }
+    if F06_SIGNAL_RESTART_NEVER.contains(&num) {
+        return 0;
+    }
+    (restart != 0) as CInt
