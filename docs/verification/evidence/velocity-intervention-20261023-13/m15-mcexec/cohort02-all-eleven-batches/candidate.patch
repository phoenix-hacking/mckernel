+        core::mem::offset_of!(OverlayFd, mck_dirents), core::mem::offset_of!(OverlayFd, mck_dirents_size),
+        core::mem::offset_of!(OverlayFd, linux_dirents), core::mem::offset_of!(OverlayFd, linux_dirents_size)];
