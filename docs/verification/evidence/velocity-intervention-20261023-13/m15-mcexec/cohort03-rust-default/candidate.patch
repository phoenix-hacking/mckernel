+unsafe fn find_unlocked(fd: c_int) -> *mut OverlayFd {
+    let head = addr_of_mut!(overlay_fd_list);
+    let mut link = (*head).next;
+    while link != head {
+        let ofd = entry(link);
+        if (*ofd).fd == fd { return ofd; }
+        link = (*link).next;
+    }
+    core::ptr::null_mut()
