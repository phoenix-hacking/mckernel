+// Equivalent to strncpy(dst, src, PATH_MAX), including zero padding.
+unsafe fn copy_path(dst: *mut u8, src: *const u8) {
+    let mut ended = false;
+    for i in 0..PATH_MAX {
+        let value = if ended { 0 } else { *src.add(i) };
+        *dst.add(i) = value;
+        ended |= value == 0;
