+               ('native-mckernel_rust.o', build / 'release-fp-regs-production/native-mckernel_rust.o', True),
+               ('legacy-mckernel_rust.o', build / 'release-fp-regs-production/legacy-mckernel_rust.o', True)]
+    for name, obj, defined in objects:
