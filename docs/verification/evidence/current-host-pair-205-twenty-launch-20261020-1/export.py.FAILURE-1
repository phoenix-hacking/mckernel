"""Finite evidence export. No workloads, root reads, binaries or catalog replay."""
from pathlib import Path
import gzip,hashlib,io,json,os,resource,stat,tarfile,time
O=Path(__file__).resolve().parent
H=Path('/home/holden/mckernel-work/host-preparation');B=H/'current-host-pair-205-launch-expansion-20261020-1';N=B/'failure-diagnostic-1';C=N/'route-proof-correction-1';D=C/'stage-preparation-1';Q=D/'native-packet-1';R=H/'current-host-pair-205-launch-expansion-diagnostic-semantic-review-20261020-1';P=H/'current-host-pair-205-launch-expansion-physical-review-20261020-1';P2=P/'route-proof-correction-1';R0=B/'failure-diagnostic-1-independent-review'
assert os.geteuid()==1000 and os.sched_getaffinity(0)=={7}
assert resource.getrlimit(resource.RLIMIT_AS)==(1<<30,1<<30) and resource.getrlimit(resource.RLIMIT_CPU)==(30,30) and resource.getrlimit(resource.RLIMIT_FSIZE)==(32<<20,32<<20)
