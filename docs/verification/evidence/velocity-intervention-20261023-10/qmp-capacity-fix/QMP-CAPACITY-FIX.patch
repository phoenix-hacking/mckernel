+    def test_exact_interpreter_row_memory_model(self):
+        import sys
+        row = json.loads(json.dumps({'direction': 'received', 'monotonic': time.monotonic(), 'raw_hex': '78'}))
+        # Include dict, distinct decoded keys, values, list reference; exclude
+        # hex payload characters, separately bounded by2*34MiB for allrows.
+        overhead = (sys.getsizeof(row) + sum(sys.getsizeof(k) for k in row) +
+                    sum(sys.getsizeof(v) for v in row.values()) - len(row['raw_hex']) + 8)
+        # Actual pinnedPython3.9 measurement542B is preserved in the first
+        # failed fixture.640B supplies98B(18.1%) perrow margin; this change
+        # qualifies only together with the full perprocess/cgroup model.
+        allowance = 640
+        fixed_overhead = 256 * 2**20
+        profile = self.transport.TRANSPORT
+        rows = profile['qmp_record_limit'] + profile['qmp_recovery_records']
+        metadata = rows * allowance
+        hex_chars = 2 * (profile['qmp_raw_bytes'] + profile['qmp_recovery_bytes'])
+        encoded_copies = 2 * profile['qmp_bytes']
+        inner_data = metadata + hex_chars + encoded_copies + profile['serial_bytes'] + profile['trace_bytes'] + profile['metadata_bytes']
+        outer_data = profile['shared_capture_bytes'] + metadata + hex_chars + encoded_copies
+        own_status = Path('/proc/self/status').read_text()
+        vm_size = int(next(line.split()[1] for line in own_status.splitlines() if line.startswith('VmSize:'))) * 1024
+        model = {'actual_decoded_row_overhead_bytes': overhead,
+                 'preserved_first_failed_measurement_bytes': 542,
+                 'row_allowance_bytes': allowance, 'row_bound': rows,
+                 'row_metadata_bytes': metadata, 'fixed_interpreter_allowance_bytes': fixed_overhead,
+                 'measured_fixture_VmSize_bytes': vm_size,
+                 'inner_data_bytes': inner_data, 'inner_with_fixed_bytes': inner_data + fixed_overhead,
+                 'outer_data_bytes': outer_data, 'outer_with_fixed_bytes': outer_data + fixed_overhead,
+                 'process_AS_bytes': 2 * 2**30, 'container_bytes': 12 * 2**30,
+                 'QEMU_bytes': 8 * 2**30,
+                 'failure_overlap_bytes': 8 * 2**30 + inner_data + fixed_overhead,
+                 'logical_growth_bytes': profile['logical_growth_bytes'],
+                 'qualification': 'Differentprocess phases; ownerreadback only afterabsence/release. Writer may run afterfailedreap; full8GiBQEMU overlap remains charged.'}
+        (EVIDENCE_ROOT / 'row-memory-model.json').write_text(json.dumps(model, indent=2) + '\n')
+        self.assertLessEqual(overhead, allowance)
+        self.assertLess(vm_size, fixed_overhead)
+        self.assertEqual(metadata, int(642.5 * 2**20))
+        self.assertEqual(inner_data, int(1654.5 * 2**20))
+        self.assertEqual(outer_data, int(1622.5 * 2**20))
+        self.assertLess(inner_data + fixed_overhead, 2 * 2**30)
+        self.assertLess(outer_data + fixed_overhead, 2 * 2**30)
+        self.assertLess(8 * 2**30 + inner_data + fixed_overhead, 12 * 2**30)
+        self.assertEqual(profile['logical_growth_bytes'], 4224 * 2**20)
+        encoded_overhead = len(json.dumps(row, sort_keys=True).encode()) - len(row['raw_hex'])
+        self.assertLessEqual(encoded_overhead, 96)
