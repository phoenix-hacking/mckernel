+def git_owner_identity():
+    # Bind the actual retained repository owner; never change ownership/config.
+    result = []
+    for path, inode in ((REPO, 47459795), (REPO / '.git', 47459796)):
+        fd, chain = safe_directory(path)
+        try:
+            s = os.fstat(fd)
+            require((s.st_dev, s.st_ino, s.st_uid, s.st_gid) == (66306, inode, 1000, 1000),
+                    'Git repository owner/directory identity changed: ' + str(path))
+            result.append((str(path), s.st_dev, s.st_ino, s.st_uid, s.st_gid, chain))
