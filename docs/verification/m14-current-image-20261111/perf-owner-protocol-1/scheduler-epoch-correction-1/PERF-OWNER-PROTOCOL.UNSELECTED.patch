+        }return 0;
+    }
+    if command==0x2401{
+        if pid==0{
+            let (_plan,_scope,r)=match unsafe{prepare_call(&event,thread)}{Ok(v)=>v,Err(error)=>return error};
+            let _=unsafe{super::hardware::stop_locked(&event,thread,r)};
+            unsafe{super::lifecycle::clear_current_monitor((*thread).proc);}
