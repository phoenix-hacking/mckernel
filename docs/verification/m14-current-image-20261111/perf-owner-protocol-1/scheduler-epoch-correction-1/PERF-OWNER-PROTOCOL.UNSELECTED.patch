+    if cpu.is_null() { return; }
+    let thread = unsafe { addr_of!((*cpu).current).read() };
+    if thread.is_null() { return; }
+    let process = unsafe { addr_of!((*thread).proc).read() };
+    if process.is_null() { return; }
