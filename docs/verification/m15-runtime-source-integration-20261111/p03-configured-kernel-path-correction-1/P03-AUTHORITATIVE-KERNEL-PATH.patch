--- a/scripts/rust/eclair-backtrace/config.rs.in
+++ b/scripts/rust/eclair-backtrace/config.rs.in
@@ -1,2 +1,2 @@
 pub const ECLAIR:&str="@prefix@/bin/eclair";
-pub const KERNEL:&str="@prefix@/smp-@ARCH@/kernel/mckernel.img";
+pub const KERNEL:&str="@MCKERNELDIR@/mckernel.img";
--- a/scripts/eclair-dump-backtrace.exp.in
+++ b/scripts/eclair-dump-backtrace.exp.in
@@ -2,7 +2,7 @@
 
 set INST_DIR "@prefix@"
 
-spawn $INST_DIR/bin/eclair -k $INST_DIR/smp-@ARCH@/kernel/mckernel.img -i -l
+spawn $INST_DIR/bin/eclair -k "@MCKERNELDIR@/mckernel.img" -i -l
 
 set state "init"
 set thread_id 0
--- a/scripts/rust/eclair-backtrace/SelectRustEclairBacktrace.cmake
+++ b/scripts/rust/eclair-backtrace/SelectRustEclairBacktrace.cmake
@@ -7,7 +7,7 @@
   if(NOT IS_ABSOLUTE "${MCKERNEL_RUNTIME_TOOL_RUSTC}" OR NOT EXISTS "${MCKERNEL_RUNTIME_TOOL_RUSTC}")
     message(FATAL_ERROR "Rust backtrace consumer requires the absolute pinned MCKERNEL_RUNTIME_TOOL_RUSTC")
   endif()
-  foreach(_value prefix ARCH)
+  foreach(_value prefix ARCH MCKERNELDIR)
     if("${${_value}}" MATCHES "[^A-Za-z0-9_./:+,@%=-]")
       message(FATAL_ERROR "Rust backtrace configuration requires reviewed literal configured values: ${_value}")
     endif()
