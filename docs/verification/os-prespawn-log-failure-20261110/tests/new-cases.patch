+    def latest_detached_receipt(self):
+        pointer = json.loads((self.directory / overnight.LATEST).read_text())
+        path = Path(pointer["receipt_path"])
+        receipt = json.loads(path.read_text())
+        self.assertEqual(receipt, pointer)
+        return path, receipt
