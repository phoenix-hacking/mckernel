+unsafe extern "C" {
+    static anon_on_demand: CInt;
+    fn do_munmap(addr: *mut c_void, len: SizeT, holding_lock: CInt) -> CInt;
+    fn f03_do_mmap_smaller_page_v2(size: SizeT, p2align: *mut CInt) -> CInt;
+}
