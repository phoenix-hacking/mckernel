{
  "scope": "Each executed control copies the same actual19records and replaces only the named published record; shared stage-lock stays unchanged. Original private INPUTS/output3/rawcommands preserve executedabsolute paths.",
  "controls": [
    {
      "control": "asm-unknown-include",
      "replace_only": ".m15_mmap_trace_gates.o.cmd",
      "base_directory": "actual-records",
      "replacement": "changed-control-records/asm-unknown-include/.m15_mmap_trace_gates.o.cmd"
    },
    {
      "control": "cross-module-owner",
      "replace_only": "mcctrl.mod",
      "base_directory": "actual-records",
      "replacement": "changed-control-records/cross-module-owner/mcctrl.mod"
    },
    {
      "control": "extra-compiler-option",
      "replace_only": ".ihk_smp_x86_64.o.cmd",
      "base_directory": "actual-records",
      "replacement": "changed-control-records/extra-compiler-option/.ihk_smp_x86_64.o.cmd"
    },
    {
      "control": "extra-dependency",
      "replace_only": ".ihk_smp_x86_64.o.cmd",
      "base_directory": "actual-records",
      "replacement": "changed-control-records/extra-dependency/.ihk_smp_x86_64.o.cmd"
    },
    {
      "control": "missing-dependency",
      "replace_only": ".ihk_smp_x86_64.o.cmd",
      "base_directory": "actual-records",
      "replacement": "changed-control-records/missing-dependency/.ihk_smp_x86_64.o.cmd"
    },
    {
      "control": "reordered-dependencies",
      "replace_only": ".ihk_smp_x86_64.o.cmd",
      "base_directory": "actual-records",
      "replacement": "changed-control-records/reordered-dependencies/.ihk_smp_x86_64.o.cmd"
    },
    {
      "control": "undeclared-config",
      "replace_only": ".mcctrl_rust.o.cmd",
      "base_directory": "actual-records",
      "replacement": "changed-control-records/undeclared-config/.mcctrl_rust.o.cmd"
    }
  ]
}
