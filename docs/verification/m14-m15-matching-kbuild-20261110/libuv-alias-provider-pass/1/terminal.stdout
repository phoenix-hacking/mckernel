        "Path": "/usr/bin/bash",
        "Args": [
            "--noprofile",
            "--norc",
            "-e",
            "-c",
            "ulimit -v 1048576; exec \"$@\"",
            "m15-consumer-as-limit",
            "/usr/bin/python3",
            "-I",
            "-B",
            "-c",
            "import hashlib, json, os, stat\nfrom pathlib import Path\nexpected_sha = \"e14ce16ebef281548fe650470d518c4e76ef179c7d15d39cdad853ec50d33d8b\"\nexpected_size = 233392\nroots = [Path(\"/usr/lib64\"), Path(\"/lib64\")]\npaths = [root / \"libuv.so.1\" for root in roots]\nreport = {\"scope\": \"Exact libuv read-only mount alias identity only\", \"status\": \"FAIL\", \"directories\": [], \"files\": []}\ntry:\n    for root in roots:\n        ls = root.lstat()\n        rs = root.resolve(strict=True)\n        report[\"directories\"].append({\"path\": str(root), \"is_symlink\": stat.S_ISLNK(ls.st_mode), \"readlink\": os.readlink(root) if stat.S_ISLNK(ls.st_mode) else None, \"resolved\": str(rs), \"st_dev\": root.stat().st_dev, \"st_ino\": root.stat().st_ino})\n        assert rs.is_dir(), \"not a resolved directory\"\n    assert roots[0].resolve(strict=True) == roots[1].resolve(strict=True), \"library directory aliases differ\"\n    assert (report[\"directories\"][0][\"st_dev\"], report[\"directories\"][0][\"st_ino\"]) == (report[\"directories\"][1][\"st_dev\"], report[\"directories\"][1][\"st_ino\"]), \"directory stat identities differ\"\n    for path in paths:\n        resolved = path.resolve(strict=True)\n        assert resolved.parent == roots[0].resolve(strict=True), \"resolved file escapes exact library directory\"\n        with path.open(\"rb\") as stream:\n            before = os.fstat(stream.fileno())\n            assert stat.S_ISREG(before.st_mode), \"not regular ELF file\"\n            assert before.st_size == expected_size, \"ELF byte count differs\"\n            payload = stream.read(expected_size + 1)\n            assert len(payload) == expected_size, \"bounded ELF read differs\"\n            digest = hashlib.sha256(payload).hexdigest()\n            after = os.fstat(stream.fileno())\n        identity = lambda st: (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)\n        assert identity(before) == identity(after) == identity(path.stat()), \"file identity changed during read\"\n        report[\"files\"].append({\"path\": str(path), \"resolved\": str(resolved), \"is_symlink\": path.is_symlink(), \"readlink\": os.readlink(path) if path.is_symlink() else None, \"st_dev\": before.st_dev, \"st_ino\": before.st_ino, \"bytes\": before.st_size, \"sha256\": digest})\n        assert digest == expected_sha, \"ELF hash differs from trusted passive provider\"\n    assert report[\"files\"][0][\"resolved\"] == report[\"files\"][1][\"resolved\"], \"resolved file paths differ\"\n    assert (report[\"files\"][0][\"st_dev\"], report[\"files\"][0][\"st_ino\"]) == (report[\"files\"][1][\"st_dev\"], report[\"files\"][1][\"st_ino\"]), \"file stat identities differ\"\n    with open(\"/proc/self/mountinfo\", \"rb\") as stream:\n        mountinfo = stream.read(262145)\n    assert len(mountinfo) <= 262144, \"mount metadata exceeded bounded read\"\n    mounted_file = report[\"files\"][0][\"resolved\"]\n    matches = [line for line in mountinfo.decode(\"ascii\").splitlines() if len(line.split()) >= 10 and line.split()[4] == mounted_file]\n    report[\"exact_mountinfo_lines\"] = matches\n    assert len(matches) == 1, \"exact library file mount not unique\"\n    assert \"ro\" in matches[0].split()[5].split(\",\"), \"actual exact file mount is not read-only\"\n    report[\"status\"] = \"PASS_EXACT_LIBUV_READONLY_ALIAS_IDENTITY\"\nexcept BaseException as error:\n    report[\"error\"] = type(error).__name__ + \": \" + str(error)\n    print(json.dumps(report, sort_keys=True), flush=True)\n    raise\nprint(json.dumps(report, sort_keys=True), flush=True)\n"
        ],
