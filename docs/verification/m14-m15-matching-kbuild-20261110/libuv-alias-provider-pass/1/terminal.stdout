.stat()), \"file identity changed during read\"\n        report[\"files\"].append({\"path\": str(path), \"resolved\": str(resolved), \"is_symlink\": path.is_symlink(), \"readlink\": os.readlink(path) if path.is_symlink() else None, \"st_dev\": before.st_dev, \"st_ino\": before.st_ino, \"bytes\": before.st_size, \"sha256\": digest})\n        assert digest == expected_sha, \"ELF hash differs from trusted passive provider\"\n    assert report[\"files\"][0][\"resolved\"] == report[\"files\"][1][\"resolved\"], \"resolved file paths differ\"\n    assert (report[\"files\"][0][\"st_dev\"], report[\"files\"][0][\"st_ino\"]) == (report[\"files\"][1][\"st_dev\"], report[\"files\"][1][\"st_ino\"]), \"file stat identities differ\"\n    with open(\"/proc/self/mountinfo\", \"rb\") as stream:\n        mountinfo = stream.read(262145)\n    assert len(mountinfo) <= 262144, \"mount metadata exceeded bounded read\"\n    mounted_file = report[\"files\"][0][\"resolved\"]\n    matches = [line for line in mountinfo.decode(\"ascii\").splitlines() if len(line.split()) >= 10 and line.split()[4] == mounted_file]\n    report[\"exact_mountinfo_lines\"] = matches\n    assert len(matches) == 1, \"exact library file mount not unique\"\n    assert \"ro\" in matches[0].split()[5].split(\",\"), \"actual exact file mount is not read-only\"\n    report[\"status\"] = \"PASS_EXACT_LIBUV_READONLY_ALIAS_IDENTITY\"\nexcept BaseException as error:\n    report[\"error\"] = type(error).__name__ + \": \" + str(error)\n    print(json.dumps(report, sort_keys=True), flush=True)\n    raise\nprint(json.dumps(report, sort_keys=True), flush=True)\n"
