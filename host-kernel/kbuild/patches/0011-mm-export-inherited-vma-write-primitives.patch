From: McKernel native Rust integration
Subject: [PATCH] mm: export exact inherited VMA write-exclusion primitives

Provide thin GPL thunks for native Rust's dormant inherited-VMA transaction.
Keep the pinned Linux lock/sequence implementation authoritative, including
vma_end_write_all from mmap_write_unlock. These exports alone enable no fork
adoption caller, root lifetime, revocation or final-destruction acknowledgement.

--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -2445,4 +2445,9 @@
 void zap_vma_ptes(struct vm_area_struct *vma, unsigned long address,
 		  unsigned long size);
+
+void mckernel_inherited_mmap_write_lock(struct mm_struct *mm);
+void mckernel_inherited_mmap_write_unlock(struct mm_struct *mm);
+void mckernel_inherited_vma_start_write(struct vm_area_struct *vma);
+
 void zap_page_range_single(struct vm_area_struct *vma, unsigned long address,
 			   unsigned long size, struct zap_details *details);
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -60,3 +60,21 @@
 #include "internal.h"
 
+void mckernel_inherited_mmap_write_lock(struct mm_struct *mm)
+{
+	mmap_write_lock(mm);
+}
+EXPORT_SYMBOL_GPL(mckernel_inherited_mmap_write_lock);
+
+void mckernel_inherited_mmap_write_unlock(struct mm_struct *mm)
+{
+	mmap_write_unlock(mm);
+}
+EXPORT_SYMBOL_GPL(mckernel_inherited_mmap_write_unlock);
+
+void mckernel_inherited_vma_start_write(struct vm_area_struct *vma)
+{
+	vma_start_write(vma);
+}
+EXPORT_SYMBOL_GPL(mckernel_inherited_vma_start_write);
+
 #ifndef arch_mmap_check
