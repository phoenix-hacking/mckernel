 #[link_name="observation_release_cpu"]fn ihk_release_cpu(index:c_int,cpus:*mut c_int,count:c_int)->c_int;
 #[link_name="observation_release_mem"]fn ihk_release_mem(index:c_int,chunks:*mut IhkMemChunk,count:c_int)->c_int;
 #[link_name="observation_create"]fn ihk_create_os(index:c_int)->c_int;
 #[link_name="observation_os_count"]fn ihk_get_num_os_instances(index:c_int)->c_int;
 #[link_name="observation_list"]fn ihk_get_os_instances(index:c_int,list:*mut c_int,count:c_int)->c_int;
 #[link_name="observation_destroy"]fn ihk_destroy_os(index:c_int,os:c_int)->c_int;
 fn observation_assign_cpu(os:c_int,cpus:*mut c_int,count:c_int)->c_int;
 fn observation_assign_mem(os:c_int,chunks:*mut IhkMemChunk,count:c_int)->c_int;
 fn observation_assigned_cpu_count(os:c_int)->c_int;
 fn observation_query_assigned_cpu(os:c_int,cpus:*mut c_int,count:c_int)->c_int;
 fn observation_release_assigned_cpu(os:c_int,cpus:*mut c_int,count:c_int)->c_int;
 fn observation_release_assigned_mem(os:c_int,chunks:*mut IhkMemChunk,count:c_int)->c_int;
 fn observation_reserve_conf(device:c_int,key:c_int,value:*mut c_void)->c_int;
 fn observation_raw(index:c_int,text:*mut c_char,error:*mut c_char)->c_int;
 fn observation_load(os:c_int,image:*mut c_char)->c_int;
 fn observation_kargs(os:c_int,args:*mut c_char)->c_int;
 fn observation_run(create:unsafe extern "C" fn(c_int,*mut c_int,*const c_char,c_int,*const c_char,*const c_char,*mut c_char)->c_int)->c_int;
}
mod os_cpu{
 use super::*;
 pub unsafe fn ihk_os_assign_cpu(os:c_int,cpus:*mut c_int,count:c_int)->c_int{unsafe{observation_assign_cpu(os,cpus,count)}}
 pub unsafe fn ihk_os_get_num_assigned_cpus(os:c_int)->c_int{unsafe{observation_assigned_cpu_count(os)}}
 pub unsafe fn ihk_os_query_cpu(os:c_int,cpus:*mut c_int,count:c_int)->c_int{unsafe{observation_query_assigned_cpu(os,cpus,count)}}
