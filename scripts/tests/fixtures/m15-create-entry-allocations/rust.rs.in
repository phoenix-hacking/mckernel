 #[link_name="observation_mem_count"]fn ihk_get_num_reserved_mem_chunks(index:c_int)->c_int;
 #[link_name="observation_query_cpu"]fn ihk_query_cpu(index:c_int,cpus:*mut c_int,count:c_int)->c_int;
