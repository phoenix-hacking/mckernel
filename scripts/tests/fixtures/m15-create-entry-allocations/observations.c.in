#define _GNU_SOURCE
#include <assert.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <ihk/ihklib_private.h>
/* Local lifecycle callbacks observe control flow only. No real IHK provider,
 * device/native effect, resource reservation or backend qualification is claimed. */
static void *owned[32],*current_pair;
static int dup_failure_seen,await_guard_restore,guard_errno,pair_guard_checks;
static int live,allocated,released,dups,fail_dup,entry_count,created,late_failure,positive_rollback,rollback_started;
static int used,events[32],checks;
static int *published_index;
static char expected_kargs[32];
static void event(int value){assert(used<32);events[used++]=value;}
static void *record(void *pointer){assert(pointer);for(int i=0;i<32;i++)if(!owned[i]){owned[i]=pointer;++live;++allocated;return pointer;}abort();}
void *observation_calloc(size_t n,size_t size){return record(calloc(n,size));}
char *observation_strndup(const char *text,size_t size){assert(!current_pair);current_pair=record(strndup(text,size));return current_pair;}
char *observation_strdup(const char *text){++dups;if(dups==fail_dup){dup_failure_seen=1;errno=ENOMEM;return NULL;}return record(strdup(text));}
void observation_free(void *pointer){
 if(await_guard_restore){assert(errno==guard_errno);await_guard_restore=0;++pair_guard_checks;}
 if(pointer==current_pair&&pointer){current_pair=NULL;if(dup_failure_seen){guard_errno=errno;await_guard_restore=1;}}
 if(pointer){int found=0;for(int i=0;i<32;i++)if(owned[i]==pointer){owned[i]=NULL;--live;++released;found=1;break;}assert(found);}
 free(pointer);errno=EIO; /* Existing outer cleanup may change errno; return stays primary. */
}
int observation_cpu_count(int device){assert(device==0);if(rollback_started){assert(live==0);if(positive_rollback)assert(errno==33);event(9);return 0;}if(created){event(21);return 1;}event(1);return 0;}
int observation_mem_count(int device){assert(device==0);event(created?23:2);return created?1:0;}
int observation_query_cpu(int device,int *cpus,int count){assert(device==0&&created&&count==1);event(22);cpus[0]=2;return 0;}
int observation_query_mem(int device,struct ihk_mem_chunk *chunks,int count){assert(device==0&&created&&count==1);event(24);chunks[0]=(struct ihk_mem_chunk){4096,0};return 0;}
int observation_create(int device){assert(device==0&&!created);created=1;event(3);return 1;}
int observation_assign_cpu(int os,int *cpus,int count){assert(os==1&&count==1&&cpus[0]==2&&*published_index==1);event(4);return 0;}
int observation_assign_mem(int os,struct ihk_mem_chunk *chunks,int count){assert(os==1&&count==1&&chunks[0].size==4096&&*published_index==1);event(5);return 0;}
int observation_load(int os,char *image){assert(os==1&&!strcmp(image,"image")&&*published_index==1);event(6);return late_failure?-41:0;}
int observation_kargs(int os,char *args){assert(os==1&&*published_index==1&&!strcmp(args,expected_kargs));event(7);return 0;}
int observation_os_count(int device){assert(device==0&&live==0);rollback_started=1;event(8);return positive_rollback?2:0;}
int observation_release_cpu(int device,int *cpus,int count){(void)device;(void)cpus;(void)count;abort();}
int observation_release_mem(int device,struct ihk_mem_chunk *chunks,int count){assert(device==0&&count==1&&chunks->size==~0UL&&chunks->numa_node_number==0&&live==0);event(10);return -72;}
/* One allocation-error vector lists two existing OSes. Original broad rollback
 * borrows this real calloc list for every release/destroy, then must free it. */
int observation_list(int device,int *list,int count){assert(device==0&&positive_rollback&&count==2&&live==1);event(11);list[0]=7;list[1]=9;return 0;}
int observation_destroy(int device,int os){assert(device==0&&(os==7||os==9)&&live==1);event(300+os);errno=33;return -73;}
int observation_assigned_cpu_count(int os){assert((os==7||os==9)&&live==1);event(100+os);return 0;}
int observation_query_assigned_cpu(int os,int *cpus,int count){(void)os;(void)cpus;(void)count;abort();}
int observation_release_assigned_cpu(int os,int *cpus,int count){(void)os;(void)cpus;(void)count;abort();}
int observation_release_assigned_mem(int os,struct ihk_mem_chunk *chunks,int count){assert((os==7||os==9)&&count==1&&chunks->size==~0UL&&chunks->numa_node_number==0&&live==1);event(200+os);return -75;}
int observation_reserve_conf(int device,int key,void *value){(void)device;(void)key;(void)value;abort();}
int observation_raw(int index,char *text,char *error){(void)index;(void)text;(void)error;abort();}
typedef int (*Create)(int,int *,const char *,int,const char *,const char *,char *);
static void check(Create create,int is_bare,int target_entry,int value_failure,int late){
 assert(live==0&&!current_pair&&!await_guard_restore);dup_failure_seen=guard_errno=pair_guard_checks=0;for(int i=0;i<32;i++)assert(!owned[i]);allocated=released=dups=created=used=rollback_started=0;
 positive_rollback=is_bare&&target_entry==2&&value_failure==1;late_failure=late;entry_count=target_entry;fail_dup=value_failure<0?0:2*(target_entry-1)+1+value_failure;
 char env[128];memset(env,0,sizeof(env));char *cursor=env;
 if(target_entry==2){strcpy(cursor,"UNUSED=kept");cursor+=strlen(cursor)+1;}
 strcpy(cursor,is_bare?"IHK_KARGS":"IHK_KARGS=chosen");
 char original[128];memcpy(original,env,sizeof(env));int index=12345;published_index=&index;
 char error[1024];memset(error,0x5a,sizeof(error));char before[1024];memcpy(before,error,sizeof(error));
 strcpy(expected_kargs,is_bare?"default":"chosen");errno=EAGAIN;
 int returned=create(0,&index,env,entry_count,"image","default",late?NULL:error);
 assert(live==0&&!current_pair&&!await_guard_restore&&allocated==released&&!memcmp(env,original,sizeof(env)));
 if(fail_dup){
  assert(pair_guard_checks==1);
  assert(returned==-ENOMEM&&index==12345&&!created&&!memcmp(error,before,sizeof(error)));
  assert(dups>=fail_dup&&dups<=2*target_entry);
  if(positive_rollback){int expected[]={1,2,8,11,107,207,307,109,209,309,9,10};assert(used==12&&!memcmp(events,expected,sizeof(expected)));}
  else{int expected[]={1,2,8,9,10};assert(used==5&&!memcmp(events,expected,sizeof(expected)));}
 }else if(late){
  assert(pair_guard_checks==0);
  assert(returned==-41&&index==1&&created&&!memcmp(error,before,sizeof(error)));
  int expected[]={1,2,3,21,22,4,23,24,5,6,8,9,10};assert(used==13&&!memcmp(events,expected,sizeof(expected)));
 }else{
  assert(pair_guard_checks==0);
  assert(returned==0&&index==1&&created&&!memcmp(error,before,sizeof(error)));
  int expected[]={1,2,3,21,22,4,23,24,5,6,7};assert(used==11&&!memcmp(events,expected,sizeof(expected)));
 }
 printf("CASE shape=%s entry=%d failed-dup=%d late=%d result=%d index=%d allocated=%d freed=%d live=%d\n",is_bare?"bare":"delimiter",target_entry,fail_dup,late,returned,index,allocated,released,live);++checks;
}
int observation_run(Create create){
 assert(getuid()==1000&&geteuid()==1000);
 for(int is_bare=0;is_bare<2;is_bare++)for(int entry=1;entry<=2;entry++)for(int value=0;value<2;value++)check(create,is_bare,entry,value,0);
 check(create,0,1,-1,0);check(create,1,1,-1,0);check(create,0,1,-1,1);
 assert(checks==11);puts("candidate creation-entry cases=11 duplicate-failures=8 success-controls=2 late-index-control=1 positive-broad-rollback=1 live-owned=0");return 0;
}
