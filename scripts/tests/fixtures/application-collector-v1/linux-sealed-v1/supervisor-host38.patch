+def _host38_waitstatus_to_exitcode(status):
+    """Host Python3.8 compatibility only; derive the real observed wait status."""
+    if type(status) is not int:
+        raise TypeError("plain raw wait status required")
+    if os.WIFEXITED(status):
+        return os.WEXITSTATUS(status)
+    if os.WIFSIGNALED(status):
+        return -os.WTERMSIG(status)
+    raise ValueError("unexpected raw wait status")
 
 
