+++ b/linux/user/rust/whole70/ihklib_os_load_boot.rs
@@ -2 +2 @@
-//! Public load/boot source port. Preserve the original polling and error contracts.
+//! Public load/boot source port with bounded polling through the first terminal result.
@@ -57 +57 @@ pub unsafe extern "C" fn ihk_os_load(index: c_int, filename: *mut c_char) -> c_i
-/// Issue BOOT and preserve the exact existing fifty-read status-poll behavior.
+/// Issue BOOT and poll at most fifty times, stopping at a terminal status or error.
@@ -86,0 +87,2 @@ pub unsafe extern "C" fn ihk_os_boot(index: c_int) -> c_int {
+        } else {
+            break;
@@ -88,2 +89,0 @@ pub unsafe extern "C" fn ihk_os_boot(index: c_int) -> c_int {
-        // The C switch's default break exits only the switch, not the for loop.
-        // Preserve all fifty status reads even after RUNNING or an earlier error.
